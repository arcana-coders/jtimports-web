            <p>Enterate primero de nuestras ofertas y promociones. Tambien noticias importantes.</p>
            
            <form id="newsletterForm">
                <div class="w-100">
                    <div class="input-group">
                        <input type="email" id="newsletterEmail" class="form-control border-light" style="padding: 30px;" placeholder="Tu correo electrónico" required>
                        <div class="input-group-append">
                            <button class="btn btn-primary px-4" type="submit" id="newsletterSubmitButton">Suscribirse</button>
                        </div>
                    </div>
                    <div id="newsletterSuccess" class="mt-2"></div>
                </div>
            </form>
            </div>
    </div>
</div>
